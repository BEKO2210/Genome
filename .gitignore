# benchmark dataset — must be downloaded separately. The directory itself
# is tracked (.gitkeep) so it exists after clone; only its contents are
# ignored.
data/*
!data/.gitkeep

# experiment outputs — append-only character; only the .gitkeep is tracked
results/*.json
results/*.jsonl

# build / dist
*.egg-info/
build/
dist/

# pytest / coverage
.pytest_cache/
.coverage
htmlcov/
